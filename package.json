{
  "name": "ai-pdf-tutor-standalone",
  "displayName": "AI PDF Tutor Standalone",
  "description": "Standalone PDF reader with streaming AI explanations for selected text.",
  "version": "0.2.0",
  "author": "AI PDF Tutor",
  "private": true,
  "main": "./out/desktop/main.js",
  "scripts": {
    "compile": "tsc -p ./",
    "start": "node out/standalone/server.js",
    "dev": "npm.cmd run compile && node out/standalone/server.js",
    "test": "npm.cmd run compile && node out/standalone-tests/selectionGate.test.js && node out/standalone-tests/server.test.js && node out/standalone-tests/publicAssets.test.js && node out/standalone-tests/readerScroll.test.js && node out/standalone-tests/readerLayout.test.js && node out/standalone-tests/desktopUpdates.test.js && node out/standalone-tests/updateIpc.test.js && node out/standalone-tests/updatePreparation.test.js",
    "lint": "eslint src/desktop src/standalone src/standalone-tests",
    "start:web": "node out/standalone/server.js",
    "desktop": "npm.cmd run compile && electron out/desktop/main.js",
    "pack:win": "npm.cmd run compile && electron-builder --win --dir",
    "dist:win": "npm.cmd run compile && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^4.10.38",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/semver": "^7.8.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "build": {
    "appId": "com.local.aipdftutor",
    "productName": "AI PDF Tutor",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jiiaxing",
        "repo": "ai-document-learning"
      }
    ],
    "files": [
      "out/**/*",
      "public/**/*",
      "ai-tutor.config.example.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "AI-PDF-Tutor-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
