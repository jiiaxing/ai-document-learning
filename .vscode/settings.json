	"aiTutor.openai.anthropicMaxTokens": 700,
	"aiTutor.fastMode": true,
	"aiTutor.maxContextTurns": 2,
	"aiTutor.maxSelectionChars": 650,
	"aiTutor.responseStyle": "plainText",
